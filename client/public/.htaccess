<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  
  # Pass sitemap.xml to PHP proxy script
  RewriteRule ^sitemap\.xml$ sitemap.php [L]

  # Pass /api requests to PHP proxy script to bypass Hostinger bot-blocks
  RewriteRule ^api/(.*)$ api_proxy.php [L]
  
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !^/(sitemap\.xml|robots\.txt|favicon\.ico)$ [NC]
  RewriteRule . /index.html [L]
</IfModule>
